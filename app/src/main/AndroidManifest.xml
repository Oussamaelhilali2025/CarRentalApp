<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau (OpenStreetMap, paiement simulé) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Localisation (géolocalisation voitures) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocationVoiture"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.LocationVoiture.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity android:name=".activities.LoginActivity" android:exported="false"/>
        <activity android:name=".activities.RegisterActivity" android:exported="false"/>

        <!-- Dashboard Admin/Employé -->
        <activity android:name=".activities.MainActivity" android:exported="false"/>

        <!-- Dashboard Client séparé (NOUVEAU) -->
        <activity android:name=".activities.ClientDashboardActivity" android:exported="false"/>

        <!-- Voitures -->
        <activity android:name=".activities.VoitureListActivity" android:exported="false"/>
        <activity android:name=".activities.VoitureFormActivity" android:exported="false"/>

        <!-- Clients -->
        <activity android:name=".activities.ClientListActivity" android:exported="false"/>
        <activity android:name=".activities.ClientFormActivity" android:exported="false"/>

        <!-- Réservations -->
        <activity android:name=".activities.ReservationListActivity" android:exported="false"/>
        <activity android:name=".activities.ReservationFormActivity" android:exported="false"/>
        <activity android:name=".activities.ReservationDetailActivity" android:exported="false"/>

        <!-- Paiements classiques -->
        <activity android:name=".activities.PaiementListActivity" android:exported="false"/>
        <activity android:name=".activities.PaiementFormActivity" android:exported="false"/>

        <!-- Paiement en ligne (NOUVEAU) -->
        <activity android:name=".activities.PaiementEnLigneActivity" android:exported="false"/>

        <!-- Géolocalisation (NOUVEAU) -->
        <activity android:name=".activities.GeolocationActivity" android:exported="false"/>

    </application>

</manifest>
