<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:theme="@style/Theme.LocationVoiture.AppBarOverlay"
            android:layout_marginHorizontal="-16dp"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Client -->
        <TextView android:id="@+id/tv_client_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Client" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>

        <Spinner android:id="@+id/spinner_client"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="16dp"/>

        <!-- Voiture -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Voiture disponible" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>

        <Spinner android:id="@+id/spinner_voiture"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="16dp"/>

        <!-- Dates -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Date de début" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
                <Button android:id="@+id/btn_date_debut"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="Choisir" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <TextView android:id="@+id/tv_date_debut"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="@color/colorPrimary"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Date de fin" android:textSize="13sp" android:textStyle="bold"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
                <Button android:id="@+id/btn_date_fin"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="Choisir" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <TextView android:id="@+id/tv_date_fin"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="@color/colorPrimary"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Prix calculé -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp" app:cardBackgroundColor="#E8F5E9">
            <TextView android:id="@+id/tv_prix_calcule"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp" android:text="Sélectionnez les dates pour voir le prix"
                android:textSize="15sp" android:textColor="@color/text_secondary"/>
        </androidx.cardview.widget.CardView>

        <!-- Bouton Sauvegarder -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="✅  Confirmer la réservation"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>
